# No football data key is required. Run npm run setup for local credentials.
# Local-only durable database; rejected on Vercel.
TGIQ_SQLITE_PATH=.data/tgiq.sqlite
# Production PostgreSQL pooled connection (server only). Takes priority over SQLite.
DATABASE_URL=
SESSION_SECRET=
PRODUCER_PASSWORD_HASH=
APP_ORIGIN=http://localhost:3000
# Optional object storage. Without it uploaded image bytes use the durable database.
BLOB_READ_WRITE_TOKEN=
# Optional future adapter credentials. Current build detects these but does not call an unverified service.
API_FOOTBALL_KEY=
SPORTMONKS_API_TOKEN=
