    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
